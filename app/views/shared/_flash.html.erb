<div style="max-width: 640px; margin: 0 auto 1rem;">
  <% if notice %>
    <div style="padding: 0.75rem 1rem; border: 1px solid #c6f6d5; background: #f0fff4; color: #22543d; margin-bottom: 0.75rem;">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div style="padding: 0.75rem 1rem; border: 1px solid #fed7d7; background: #fff5f5; color: #742a2a; margin-bottom: 0.75rem;">
      <%= alert %>
    </div>
  <% end %>
</div>
